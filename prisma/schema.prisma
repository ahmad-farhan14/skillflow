// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id               String         @id @default(uuid()) @db.Uuid
  email            String         @unique
  fullName         String         @map("full_name")
  avatarUrl        String?        @map("avatar_url")
  currentStreak    Int            @default(0) @map("current_streak")
  lastActiveDate   DateTime?      @map("last_active_date") @db.Date
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  progressRecords  UserProgress[]
  notes            Note[]

  @@map("profiles")
}

model Roadmap {
  id             String    @id @default(uuid()) @db.Uuid
  slug           String    @unique
  title          String
  description    String    @db.Text
  category       String    // "Development" | "Design"
  icon           String    // Lucide icon name or emoji identifier
  estimatedHours Int       @map("estimated_hours")
  level          String    @default("Beginner Friendly")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  modules        Module[]
  notes          Note[]

  @@map("roadmaps")
}

model Module {
  id          String    @id @default(uuid()) @db.Uuid
  roadmapId   String    @map("roadmap_id") @db.Uuid
  title       String
  description String    @db.Text
  orderIndex  Int       @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  roadmap     Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      Topic[]
  notes       Note[]

  @@index([roadmapId, orderIndex])
  @@map("modules")
}

model Topic {
  id             String         @id @default(uuid()) @db.Uuid
  moduleId       String         @map("module_id") @db.Uuid
  title          String
  description    String?        @db.Text
  resourceUrl    String?        @map("resource_url")
  resourceLabel  String?        @map("resource_label")
  orderIndex     Int            @map("order_index")
  estimatedMins  Int?           @default(30) @map("estimated_mins")
  difficulty     String?        @default("Beginner") // "Beginner" | "Intermediate" | "Advanced"
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  module         Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress       UserProgress[]

  @@index([moduleId, orderIndex])
  @@map("topics")
}

model UserProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  topicId     String    @map("topic_id") @db.Uuid
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  // Relations
  profile     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@map("user_progress")
}

model Note {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roadmapId String    @map("roadmap_id") @db.Uuid
  moduleId  String?   @map("module_id") @db.Uuid
  content   String    @db.Text
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap   Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  module    Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([userId, roadmapId])
  @@index([userId, moduleId])
  @@map("notes")
}
